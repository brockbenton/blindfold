{
  "name": "blindfold",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "demo": "pnpm --filter @blindfold/scripts demo",
    "bot": "pnpm --filter @blindfold/scripts bot",
    "serve": "pnpm --filter @blindfold/scripts serve",
    "crowd": "pnpm --filter @blindfold/scripts crowd",
    "streams:setup": "pnpm --filter @blindfold/scripts streams:setup",
    "gateway": "pnpm --filter @blindfold/gateway start",
    "gateway:setup": "pnpm --filter @blindfold/scripts gateway:setup",
    "replay": "pnpm --filter @blindfold/scripts replay",
    "replay:publish": "pnpm --filter @blindfold/scripts replay:publish"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}

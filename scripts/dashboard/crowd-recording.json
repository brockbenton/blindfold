======================"},{"t":3,"act":0,"text":"   Mode: local rehearsal (throwaway validator, fresh keys)."},{"t":4,"act":0,"text":""},{"t":4,"act":0,"text":"     starting a local Solana validator with the vault program"},{"t":1214,"act":0,"text":"     funding 3 owners and 3 exact agents, each straight from the test USDC mint"},{"t":10653,"act":0,"text":"     starting the repository's local PostgreSQL (services/mint/scripts/dev-pg.sh)"},{"t":10728,"act":0,"text":"     starting the mint and the feed"},{"t":11307,"act":0,"text":""},{"t":11307,"act":0,"text":"   The crowd"},{"t":11308,"act":0,"text":"   Agent A        researches SOL: whale flow, whale flow, depth"},{"t":11308,"act":0,"text":"   Agent B        researches BTC: depth, whale flow"},{"t":11308,"act":0,"text":"   Agent C        researches ETH: whale flow, depth, whale flow"},{"t":11308,"act":0,"text":"   Each agent has its own owner wallet, funded separately before the observer starts watching. TokenFeed"},{"t":11308,"act":0,"text":"   sells whale flow at 5 cents and depth at 10 cents."},{"t":11317,"act":0,"text":""},{"t":11317,"act":0,"text":"   Live dashboard: http://localhost:5173 (open it next to this terminal)"},{"t":11320,"act":1,"text":""},{"t":11320,"act":1,"text":"================================================================================"},{"t":11321,"act":1,"text":"  1. The crowd pays with standard x402"},{"t":11321,"act":1,"text":"  Each agent pays from its own wallet; the calls are interleaved, as they would be on a busy feed."},{"t":11321,"act":1,"text":"================================================================================"},{"t":12601,"act":1,"text":"  ok   Agent B paid 10 cents for depth BTC  5BTg...HS8Y"},{"t":13847,"act":1,"text":"  ok   Agent A paid 5 cents for whale flow SOL  4sqM...dHEu"},{"t":15143,"act":1,"text":"  ok   Agent C paid 5 cents for whale flow ETH  FfsY...5SuC"},{"t":16401,"act":1,"text":"  ok   Agent A paid 5 cents for whale flow SOL  4sqM...dHEu"},{"t":17382,"act":1,"text":"  ok   Agent B paid 5 cents for whale flow BTC  5BTg...HS8Y"},{"t":18653,"act":1,"text":"  ok   Agent C paid 10 cents for depth ETH  FfsY...5SuC"},{"t":19691,"act":1,"text":"  ok   Agent A paid 10 cents for depth SOL  4sqM...dHEu"},{"t":20669,"act":1,"text":"  ok   Agent C paid 5 cents for whale flow ETH  FfsY...5SuC"},{"t":20669,"act":1,"text":"     The observer is scanning the feed's USDC account"},{"t":20696,"act":1,"text":""},{"t":20697,"act":1,"text":"  Observer  BUY BTC   Agent 5BTg...HS8Y is researching BTC hard: 2 paid reads (1 depth, 1 whale-flow) in 4 seconds. A trade is coming; buy BTC before it does."},{"t":20697,"act":1,"text":"  Observer  BUY SOL   Agent 4sqM...dHEu is researching SOL hard: 3 paid reads (2 whale-flow, 1 depth) in 6 seconds. A trade is coming; buy SOL before it does."},{"t":20697,"act":1,"text":"  Observer  BUY ETH   Agent FfsY...5SuC is researching ETH hard: 3 paid reads (2 whale-flow, 1 depth) in 6 seconds. A trade is coming; buy ETH before it does."},{"t":20698,"act":1,"text":"   Interleaving did not help: every payment names its wallet, so the observer sorts them per agent. 3 of"},{"t":20698,"act":1,"text":"   3 agents attributed, wallet and token."},{"t":20698,"act":2,"text":""},{"t":20698,"act":2,"text":"================================================================================"},{"t":20698,"act":2,"text":"  2. The crowd switches to Blindfold"},{"t":20698,"act":2,"text":"  Each owner deposits the same $1.00 into the vault, in no particular order."},{"t":20698,"act":2,"text":"================================================================================"},{"t":26936,"act":2,"text":"  ok   owner 7yNx...KP9F deposited $1.00; Agent A holds 40 tokens"},{"t":33033,"act":2,"text":"  ok   owner 2koe...B9Re deposited $1.00; Agent B holds 40 tokens"},{"t":39913,"act":2,"text":"  ok   owner 9wrN...r6wr deposited $1.00; Agent C holds 40 tokens"},{"t":39914,"act":2,"text":"   Equal amounts matter: a distinctive deposit is a fingerprint, and a deposit too small to cover a"},{"t":39914,"act":2,"text":"   payout rules its owner out (act 5 shows this)."},{"t":39914,"act":3,"text":""},{"t":39914,"act":3,"text":"================================================================================"},{"t":39914,"act":3,"text":"  3. The same research, paid with Blindfold"},{"t":39914,"act":3,"text":"  Same agents, same tokens, same interleaving. Each payment is an ecash token in an HTTP header."},{"t":39914,"act":3,"text":"================================================================================"},{"t":40325,"act":3,"text":"  ok   Agent C paid 5 cents for whale flow ETH  (token, no transaction)"},{"t":40810,"act":3,"text":"  ok   Agent B paid 10 cents for depth BTC  (token, no transaction)"},{"t":41300,"act":3,"text":"  ok   Agent A paid 5 cents for whale flow SOL  (token, no transaction)"},{"t":41837,"act":3,"text":"  ok   Agent C paid 10 cents for depth ETH  (token, no transaction)"},{"t":42374,"act":3,"text":"  ok   Agent B paid 5 cents for whale flow BTC  (token, no transaction)"},{"t":42793,"act":3,"text":"  ok   Agent A paid 5 cents for whale flow SOL  (token, no transaction)"},{"t":43167,"act":3,"text":"  ok   Agent C paid 5 cents for whale flow ETH  (token, no transaction)"},{"t":43729,"act":3,"text":"  ok   Agent A paid 10 cents for depth SOL  (token, no transaction)"},{"t":43731,"act":3,"text":""},{"t":43731,"act":3,"text":"  Observer  NO SIGNAL 55 cents of purchases, 0 new transactions at the feed."},{"t":43731,"act":4,"text":""},{"t":43732,"act":4,"text":"================================================================================"},{"t":43732,"act":4,"text":"  4. One settlement pays the feed for everyone"},{"t":43732,"act":4,"text":"  The mint pays what the feed is owed in one vault transaction."},{"t":43732,"act":4,"text":"================================================================================"},{"t":43732,"act":4,"text":"   To keep this run short the mint settles on request and pays in full. A deployed mint pays at its"},{"t":43732,"act":4,"text":"   next fixed window, after a hold, in rounded amounts (pnpm demo, Act 4); that hides timing, not"},{"t":43732,"act":4,"text":"   who deposited."},{"t":44286,"act":4,"text":"  ok   the feed received $0.55 in one transaction; books: vault +$3.00 - $0.55 = +$2.45"},{"t":44286,"act":4,"text":""},{"t":44286,"act":4,"text":"   7yNx...KP9F deposited $1.00 into the Blindfold vault. What it buys: unknown"},{"t":44286,"act":4,"text":"   2koe...B9Re deposited $1.00 into the Blindfold vault. What it buys: unknown"},{"t":44287,"act":4,"text":"   9wrN...r6wr deposited $1.00 into the Blindfold vault. What it buys: unknown"},{"t":44287,"act":4,"text":"   Blindfold vault paid the feed $0.55 in a batch. Payer: unknown"},{"t":44287,"act":4,"text":"  Observer  CANNOT ATTRIBUTE"},{"t":44287,"act":4,"text":"  Observer  3 wallets deposited the same $1.00 each, and 1 payout ($0.55) could be any mix of their purchases. Who bought what, and which token anyone researched: unknown."},{"t":44287,"act":5,"text":""},{"t":44287,"act":5,"text":"================================================================================"},{"t":44287,"act":5,"text":"  5. What breaks it: odd amounts"},{"t":44287,"act":5,"text":"  A second round. Agent A's owner deposits $2.37; the others deposit $0.10 each. Each agent spends"},{"t":44287,"act":5,"text":"  only this round's tokens."},{"t":44287,"act":5,"text":"================================================================================"},{"t":45646,"act":5,"text":"  ok   owner 9wrN...r6wr deposited $0.10; Agent C holds 6 tokens"},{"t":47678,"act":5,"text":"  ok   owner 2koe...B9Re deposited $0.10; Agent B holds 6 tokens"},{"t":63122,"act":5,"text":"  ok   owner 7yNx...KP9F deposited $2.37; Agent A holds 85 tokens"},{"t":63485,"act":5,"text":"  ok   Agent A paid 10 cents for depth SOL  (token, no transaction)"},{"t":63840,"act":5,"text":"  ok   Agent B paid 5 cents for whale flow BTC  (token, no transaction)"},{"t":64196,"act":5,"text":"  ok   Agent A paid 5 cents for whale flow SOL  (token, no transaction)"},{"t":64633,"act":5,"text":"  ok   Agent A paid 5 cents for whale flow SOL  (token, no transaction)"},{"t":65079,"act":5,"text":"  ok   Agent A paid 5 cents for whale flow SOL  (token, no transaction)"},{"t":65460,"act":5,"text":"  ok   Agent A paid 10 cents for depth SOL  (token, no transaction)"},{"t":65969,"act":5,"text":"  ok   Agent C paid 5 cents for whale flow ETH  (token, no transaction)"},{"t":66453,"act":5,"text":""},{"t":66453,"act":5,"text":"  Observer  PARTIAL"},{"t":66453,"act":5,"text":"  Observer  3 wallets deposited $2.57 between them, but the 1 payout ($0.45) is more than the others could cover without 7yNx...KP9F. Amounts give it away; tokens: unknown."},{"t":66453,"act":5,"text":"   The small deposits hold $0.20 together, less than the $0.45 payout, so the big depositor must"},{"t":66453,"act":5,"text":"   have bought from TokenFeed. The token stays hidden; the wallet does not. Boring, equal amounts"},{"t":66453,"act":5,"text":"   avoid this."},{"t":66453,"act":6,"text":""},{"t":66453,"act":6,"text":"================================================================================"},{"t":66453,"act":6,"text":"  6. The observer's report"},{"t":66453,"act":6,"text":"  The same crowd and the same purchases, paid two ways."},{"t":66453,"act":6,"text":"================================================================================"},{"t":66453,"act":6,"text":""},{"t":66453,"act":6,"text":"   Standard x402 (exact)"},{"t":66453,"act":6,"text":"   Agent A        4sqM...dHEu  3 calls, $0.20, SOL: BUY SOL"},{"t":66453,"act":6,"text":"   Agent B        5BTg...HS8Y  2 calls, $0.15, BTC: BUY BTC"},{"t":66453,"act":6,"text":"   Agent C        FfsY...5SuC  3 calls, $0.20, ETH: BUY ETH"},{"t":66453,"act":6,"text":""},{"t":66453,"act":6,"text":"   Blindfold x402 (blindfold), equal deposits"},{"t":66453,"act":6,"text":"   Agent ?        7yNx...KP9F  deposited $1.00; bought: unknown; token: unknown"},{"t":66453,"act":6,"text":"   Agent ?        2koe...B9Re  deposited $1.00; bought: unknown; token: unknown"},{"t":66453,"act":6,"text":"   Agent ?        9wrN...r6wr  deposited $1.00; bought: unknown; token: unknown"},{"t":66453,"act":6,"text":"   Payout         $0.55 from the vault to TokenFeed in one batch"},{"t":66453,"act":6,"text":"   Verdict        CANNOT ATTRIBUTE"},{"t":66454,"act":6,"text":"   With a crowd of one, the same payout would read: LINKED. Only 7yNx...KP9F deposited in this"},{"t":66454,"act":6,"text":"   window, so it funded the 1 payout ($0.55) to the feed. Which token it researched: unknown, but"},{"t":66454,"act":6,"text":"   the wallet is linked to the feed."},{"t":66454,"act":6,"text":""},{"t":66454,"act":6,"text":"   Blindfold x402 (blindfold), odd amounts"},{"t":66454,"act":6,"text":"   Verdict        PARTIAL: 7yNx...KP9F bought from TokenFeed; token: unknown"},{"t":66454,"act":6,"text":""},{"t":66454,"act":6,"text":"   What still leaks"},{"t":66454,"act":6,"text":"   - Funding: if the owners' USDC came from one wallet, that transfer links them. Here each was"},{"t":66454,"act":6,"text":"   funded on its own, before the observer started watching."},{"t":66454,"act":6,"text":"   - Amounts: odd or uneven deposits can single out a depositor, as act 5 showed."},{"t":66454,"act":6,"text":"   - Size: the payout total bounds the crowd's spending, and the feed's revenue is public."},{"t":66454,"act":6,"text":"   - Timing: deposits right before a payout, or one owner's deposits always followed by large"},{"t":66454,"act":6,"text":"   payouts, can be correlated over time."},{"t":66454,"act":6,"text":"   - The feed and the mint: the feed sees the queries and IP addresses; the mint sees redemption"},{"t":66454,"act":6,"text":"   amounts and times."},{"t":66454,"act":6,"text":""},{"t":66454,"act":6,"text":"Crowd demo complete."}]}
